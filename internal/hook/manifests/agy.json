{
  "schema": 1,
  "adapter": "agy",
  "display_name": "Antigravity",
  "aliases": ["antigravity"],
  "setup_order": 3,
  "revision": "agy-2",
  "prior_revisions": {
    "agy-1": []
  },
  "event_field": "hookEventName",
  "session_field": "conversationId",
  "session_env": "ANTIGRAVITY_CONVERSATION_ID",
  "identity": {
    "evidence": "observed",
    "verified_on": ["1.5.16"],
    "agent_markers": ["ANTIGRAVITY_AGENT"],
    "version": {"env": "ANTIGRAVITY_LS_VERSION", "prefix": "cli-", "indirect": "ls", "indirect_name": "language server", "cli_build": true}
  },
  "host_names": ["agy"],
  "event_field_optional": true,
  "cwd_field": "workspacePaths",
  "cwd_list": true,
  "identity_proof": "antigravity_transcript",
  "empty_output": "{}",
  "build_from_host": true,
  "host_modes": {"print": ["-p", "--print", "--prompt"]},
  "host_mode_default": "interactive",
  "literal_fields": ["invocationNum", "initialNumSteps", "executionNum", "fullyIdle"],
  "stop_active": {"field": "executionNum", "inactive": "0"},
  "install": {
    "file": "hooks.json",
    "encoding": "shell",
    "timeout_s": 1,
    "events": ["SessionStart", "PreInvocation", "Stop"]
  },
  "events": {
    "SessionStart": {"enroll": true, "source": "startup", "output": "inject_steps"},
    "PreInvocation": {"fact": "prompt_submitted", "notice": true, "output": "inject_steps", "turn_required": true,
      "when": {"invocationNum": "0"}, "turn_field": "initialNumSteps", "open_turn": true},
    "Stop": {"fact": "turn_finishing", "stop": true, "output": "continue", "turn_from_open": true,
      "ref_fields": ["executionNum"], "stop_require": {"terminationReason": "NO_TOOL_CALL", "fullyIdle": "true", "error": ""}}
  }
}
