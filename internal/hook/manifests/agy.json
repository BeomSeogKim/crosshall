{
  "adapter": "agy",
  "revision": "agy-1",
  "event_field": "hookEventName",
  "session_field": "conversationId",
  "session_env": "ANTIGRAVITY_CONVERSATION_ID",
  "host_names": ["agy"],
  "install": {
    "file": "hooks.json",
    "encoding": "shell",
    "timeout_s": 1,
    "events": ["SessionStart"]
  },
  "events": {
    "SessionStart": {"enroll": true, "output": "inject_steps"}
  }
}
