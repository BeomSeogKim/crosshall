{
  "schema": 1,
  "adapter": "agy",
  "display_name": "Antigravity",
  "aliases": ["antigravity"],
  "setup_order": 3,
  "revision": "agy-1",
  "event_field": "hookEventName",
  "session_field": "conversationId",
  "session_env": "ANTIGRAVITY_CONVERSATION_ID",
  "identity": {
    "evidence": "observed",
    "verified_on": ["1.5.11"],
    "agent_markers": ["ANTIGRAVITY_AGENT"],
    "version": {"env": "ANTIGRAVITY_LS_VERSION", "prefix": "cli-", "indirect": "ls", "indirect_name": "language server"}
  },
  "host_names": ["agy"],
  "event_field_optional": true,
  "cwd_field": "workspacePaths",
  "cwd_list": true,
  "identity_proof": "antigravity_transcript",
  "empty_output": "{}",
  "install": {
    "file": "hooks.json",
    "encoding": "shell",
    "timeout_s": 1,
    "events": ["SessionStart"]
  },
  "events": {
    "SessionStart": {"enroll": true, "source": "startup", "output": "inject_steps"}
  }
}
