{
  "adapter": "claude",
  "revision": "claude-1",
  "event_field": "hook_event_name",
  "session_field": "session_id",
  "session_env": "CLAUDE_CODE_SESSION_ID",
  "launch_env": "CLAUDE_PID",
  "turn_field": "prompt_id",
  "events": {
    "SessionStart": {"enroll": true, "source_field": "source", "output": "context"},
    "UserPromptSubmit": {"fact": "prompt_submitted", "turn_required": true, "notice": true, "output": "context"},
    "Stop": {"fact": "turn_finishing", "turn_required": true, "stop": true, "output": "context"},
    "StopFailure": {"fact": "turn_finishing", "turn_required": true},
    "Notification": {"fact": "approval_requested", "match_field": "notification_type", "match_value": "permission_prompt"},
    "SessionEnd": {"fact": "session_ended", "reason_field": "reason"}
  }
}
