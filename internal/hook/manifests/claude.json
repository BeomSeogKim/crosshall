{
  "adapter": "claude",
  "display_name": "Claude Code",
  "revision": "claude-3",
  "prior_revisions": {
    "claude-1": ["process_launch", "turn_end", "recover_enroll"],
    "claude-2": ["process_launch", "turn_end", "recover_enroll"]
  },
  "event_field": "hook_event_name",
  "session_field": "session_id",
  "session_env": "CLAUDE_CODE_SESSION_ID",
  "launch_env": "CLAUDE_PID",
  "socket_env": "CLAUDE_CODE_MESSAGING_SOCKET",
  "turn_field": "prompt_id",
  "prompt_entry_ref": true,
  "version_env": "AI_AGENT",
  "version_pattern": "^claude-code_([0-9]+-[0-9]+-[0-9]+)_(?:harness|agent)$",
  "mode_env": "CLAUDE_CODE_ENTRYPOINT",
  "mode_field": "permission_mode",
  "modes": {"sdk-cli": "print", "cli": "interactive"},
  "caps_ms": {"prompt_submitted": 1800000, "turn_finishing": 7200000, "approval_requested": 1800000},
  "install": {
    "home_env": "CLAUDE_CONFIG_DIR",
    "file": "settings.json",
    "encoding": "argv",
    "timeout_s": 1,
    "events": ["SessionStart", "UserPromptSubmit", "Stop", "StopFailure", "Notification", "SessionEnd"],
    "matchers": {"Notification": "permission_prompt|idle_prompt"}
  },
  "events": {
    "SessionStart": {"enroll": true, "source_field": "source", "output": "context"},
    "UserPromptSubmit": {"fact": "prompt_submitted", "turn_required": true, "notice": true, "output": "context", "recover_enroll": true},
    "Stop": {"fact": "turn_finishing", "turn_required": true, "stop": true, "output": "context"},
    "StopFailure": {"fact": "turn_finishing", "turn_required": true},
    "Notification": {"match_field": "notification_type", "facts_by_match": {"permission_prompt": "approval_requested", "idle_prompt": "idle_prompt"}},
    "SessionEnd": {"fact": "session_ended", "reason_field": "reason"}
  }
}
