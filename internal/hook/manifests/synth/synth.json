{
  "schema": 1,
  "adapter": "synth",
  "display_name": "Synth Fixture",
  "setup_order": 9,
  "revision": "synth-1",
  "event_field": "event",
  "session_field": "session",
  "session_env": "SYNTH_SESSION_ID",
  "identity": {
    "evidence": "observed",
    "verified_on": ["1.0.0"],
    "agent_markers": ["SYNTH_AGENT"],
    "version": {"env": "SYNTH_VERSION"}
  },
  "install": {
    "home_env": "SYNTH_HOME",
    "file": "hooks.json",
    "encoding": "argv",
    "timeout_s": 1,
    "events": ["SessionStart", "UserPromptSubmit"]
  },
  "events": {
    "SessionStart": {"enroll": true, "source": "startup", "output": "context"},
    "UserPromptSubmit": {"fact": "prompt_submitted", "notice": true, "output": "context"}
  }
}
